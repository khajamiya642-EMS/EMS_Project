<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h2 mb-1">Departments</h1>
    <p class="text-body-secondary mb-0">Manage departments and their employee counts.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Employees", employees_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Add department", new_department_path, class: "btn btn-primary" %>
  </div>
</div>

<% if @departments.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col">Department</th>
          <th scope="col">Employee count</th>
          <th scope="col" class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @departments.each do |department| %>
          <tr>
            <td class="fw-semibold"><%= link_to department.name, department_path(department) %></td>
            <td><span class="badge text-bg-primary"><%= department.employees_count %></span></td>
            <td class="text-end text-nowrap">
              <%= link_to "View", department_path(department), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Edit", edit_department_path(department), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Delete", department_path(department), method: :delete,
                    form_class: "d-inline", class: "btn btn-sm btn-outline-danger",
                    data: { turbo_confirm: "Delete #{department.name}? Departments with employees cannot be deleted." } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card border-0 bg-body-tertiary text-center">
    <div class="card-body py-5">
      <h2 class="h5">No departments yet</h2>
      <p class="text-body-secondary">Create a department before assigning employees.</p>
      <%= link_to "Add department", new_department_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
