<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h2 mb-1"><%= @department.name %></h1>
    <p class="text-body-secondary mb-0"><%= pluralize(@employees.size, "employee") %></p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "All departments", departments_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Edit", edit_department_path(@department), class: "btn btn-outline-primary" %>
    <%= link_to "Assign employee", new_employee_path(department_id: @department.id), class: "btn btn-primary" %>
  </div>
</div>

<%= render "employees/employee_table", employees: @employees %>
