<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <p class="text-body-secondary mb-1"><%= @employee.department.name %></p>
    <h1 class="h2 mb-0"><%= @employee.name %></h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back to employees", employees_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Edit", edit_employee_path(@employee), class: "btn btn-primary" %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-header bg-white">
    <h2 class="h5 mb-0">Employee details</h2>
  </div>
  <dl class="row card-body mb-0">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9"><%= mail_to @employee.email %></dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9"><%= @employee.phone %></dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9"><%= link_to @employee.department.name, department_path(@employee.department) %></dd>

    <dt class="col-sm-3">Employee ID</dt>
    <dd class="col-sm-9"><%= @employee.id %></dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span class="badge <%= @employee.active? ? "text-bg-success" : "text-bg-secondary" %>"><%= @employee.status %></span></dd>

    <dt class="col-sm-3">Joining date</dt>
    <dd class="col-sm-9"><%= l(@employee.joining_date, format: :long) %></dd>
    <dt class="col-sm-3">Salary</dt>
    <dd class="col-sm-9"><%= number_to_currency(@employee.salary, precision: 0) %></dd>

    <dt class="col-sm-3">Manager</dt>
    <dd class="col-sm-9"><%= @employee.manager&.name || "—" %></dd>
  </dl>
</div>

<% if @employee.subordinates.any? %>
  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h2 class="h5 mb-0">Direct reports</h2>
      <%= link_to "View all", subordinates_employee_path(@employee), class: "btn btn-sm btn-outline-primary" %>
    </div>
    <ul class="list-group list-group-flush">
      <% @employee.subordinates.order(:name).each do |subordinate| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span><%= subordinate.name %> <span class="text-body-secondary">· <%= subordinate.department.name %></span></span>
          <%= link_to "View", employee_path(subordinate), class: "btn btn-sm btn-outline-secondary" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
