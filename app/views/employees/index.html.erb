<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h2 mb-1">Employees</h1>
    <p class="text-body-secondary mb-0">Manage your organization's employee directory.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Manage departments", departments_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Teams by manager", teams_path, class: "btn btn-outline-primary" %>
    <%= link_to "Add employee", new_employee_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: employees_path, method: :get, class: "row g-3 align-items-end" do |form| %>
      <div class="col-lg-4">
        <%= form.label :q, "Search employees", class: "form-label" %>
        <%= form.search_field :q, value: params[:q], class: "form-control",
              placeholder: "Name, employee ID, email, department, or manager" %>
      </div>
      <div class="col-sm-6 col-lg-2">
        <%= form.label :department_id, "Department", class: "form-label" %>
        <%= form.collection_select :department_id, @departments, :id, :name,
              { include_blank: "All departments" }, class: "form-select" %>
      </div>
      <div class="col-sm-6 col-lg-2">
        <%= form.label :manager_id, "Manager", class: "form-label" %>
        <%= form.collection_select :manager_id, @managers, :id, :name,
              { include_blank: "All managers" }, class: "form-select" %>
      </div>
      <div class="col-sm-6 col-lg-2">
        <%= form.label :status, "Status", class: "form-label" %>
        <%= form.select :status, [["All statuses", ""], ["Active", "active"], ["Inactive", "inactive"]],
              { selected: params[:status] }, class: "form-select" %>
      </div>
      <div class="col-sm-6 col-lg-2">
        <%= form.label :joined_from, "Joined from", class: "form-label" %>
        <%= form.date_field :joined_from, value: params[:joined_from], class: "form-control" %>
      </div>
      <div class="col-sm-6 col-lg-2">
        <%= form.label :joined_to, "Joined to", class: "form-label" %>
        <%= form.date_field :joined_to, value: params[:joined_to], class: "form-control" %>
      </div>
      <div class="col-12 d-flex gap-2">
        <%= form.submit "Apply filters", class: "btn btn-primary" %>
        <%= link_to "Clear filters", employees_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<%= render "employee_table", employees: @employees %>
